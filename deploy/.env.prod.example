# ── Obligatorio ────────────────────────────────────────────────────────────
# El dominio público EXACTO (sin slash final). La API lo usa para el chequeo
# de embebido de YouTube; si queda en localhost, varios videos "no se pueden reproducir".
PUBLIC_APP_URL=https://karaoke.tudominio.com

# Puerto HTTP expuesto (usado por el proxy de Cloudflare / Tunnel → localhost).
PUBLIC_PORT=8080

# ── Agente de validación karaoke (opcional) ───────────────────────────────
# Sin API key → ranking heurístico (funciona igual).
KARAOKE_AGENT_PROVIDER=heuristic
# KARAOKE_AGENT_API_KEY=sk-ant-...
# KARAOKE_AGENT_MODEL=claude-3-5-haiku-latest

# ── Opcional ──────────────────────────────────────────────────────────────
# NODE_ENV=production
# CORS_ORIGINS=https://karaoke.tudominio.com